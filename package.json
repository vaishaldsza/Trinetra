{
  "name": "trinetra-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TRINETRA - Intelligent Outdoor Safety & Emergency Response System",
  "scripts": {
    "dev:web": "pnpm --filter @trinetra/web dev",
    "dev:mobile": "pnpm --filter @trinetra/mobile start",
    "build:shared": "pnpm --filter @trinetra/shared build",
    "build:web": "pnpm --filter @trinetra/web build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @trinetra/mobile test",
    "build": "pnpm run build:shared && pnpm run build:web"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
